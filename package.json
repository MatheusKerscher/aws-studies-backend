{
  "name": "aws-first-server",
  "version": "1.0.0",
  "description": "Create, test and learning about the AWS plataform",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "tsx watch index.ts",
    "services:up": "docker compose -f infra/docker/compose.yaml up -d",
    "services:stop": "docker compose -f infra/docker/compose.yaml stop",
    "services:down": "docker compose -f infra/docker/compose.yaml down",
    "migrations:create": "npx prisma migrate dev",
    "migrations:generate": "npx prisma generate"
  },
  "keywords": [
    "AWS",
    "backend",
    "express",
    "typescript"
  ],
  "author": "Matheus Kerscher",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "dotenv-expand": "1000.0.0",
    "express": "5.2.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "prisma": "7.9.1",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  }
}